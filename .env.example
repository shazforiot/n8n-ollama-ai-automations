# Copy to .env (the start scripts do this and generate random secrets for you)

# --- which Ollama to use: cpu | gpu-nvidia | (empty = Ollama app on your computer, see OLLAMA_BASE_URL) ---
COMPOSE_PROFILES=cpu

# --- versions (pin these for a stable setup, e.g. N8N_VERSION=2.46.5) ---
N8N_VERSION=stable
OLLAMA_VERSION=latest

# --- local models (small enough for 8 GB RAM; change to e.g. qwen3:4b or llama3.1:8b on bigger machines) ---
CHAT_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text

# --- where n8n finds Ollama ---
# Docker Ollama (cpu / gpu-nvidia profiles):
OLLAMA_BASE_URL=http://ollama:11434
# Ollama app installed on your computer ("host" profile): use this instead
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- database ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=n8n

# --- n8n secrets (keep them; changing the encryption key later makes saved credentials unreadable) ---
N8N_ENCRYPTION_KEY=change-me-encryption-key
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-jwt-secret

# --- misc ---
GENERIC_TIMEZONE=Europe/Berlin
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
# Uncomment only if you open n8n from another device over plain http (not localhost)
# N8N_SECURE_COOKIE=false
